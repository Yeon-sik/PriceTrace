      "css": ".ds-primary{font-family:var(--font-suit),sans-serif;font-size:15px;line-height:1.55;padding:9px 12px;border:1px solid transparent;border-radius:5px;background:var(--brand,#2a6342);color:var(--on-brand,#f2f7f0);cursor:pointer;transition:background-color 160ms,border-color 160ms,color 160ms;}.ds-primary:disabled{background:var(--surface-raised,#202922);color:var(--subtle,#91a096);cursor:not-allowed;}.ds-primary:focus-visible{outline:2px solid var(--accent,#a5deac);outline-offset:4px;}@media(prefers-reduced-motion:reduce){button,input{transition:none;animation:none;}}"
